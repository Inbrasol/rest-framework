<odoo>
    <data>
        <record id="view_account_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add your custom fields or modifications here -->
                <notebook position="inside">
                    <page name="salesforce" string="Salesforce">
                        <group>
                            <field name="sf_id" readonly="1"/>
                            <field name="sf_integration_status" readonly="1"/>
                            <field name="sf_integration_datetime" readonly="1"/>
                            <field name="sf_integration_error" readonly="1"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
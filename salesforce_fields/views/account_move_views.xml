<odoo>
    <data>
        <record id="view_account_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add Salesforce button in header -->
                <xpath expr="//header" position="inside">
                    <button name="action_open_in_salesforce"
                            type="object"
                            string="Ver en Salesforce"
                            class="oe_highlight"
                            icon="fa-cloud"
                            invisible="not sf_id"
                            groups="salesforce_fields.group_salesforce_user"
                            help="Abrir registro en Salesforce"/>
                </xpath>
                <!-- Add your custom fields or modifications here -->
                <notebook position="inside">
                    <page name="salesforce" string="Salesforce">
                        <group>
                            <field name="sf_id" readonly="1"/>
                            <field name="sf_integration_status" readonly="1"/>
                            <field name="sf_integration_datetime" readonly="1"/>
                            <field name="sf_integration_error" readonly="1"/>
                        </group>
                    </page>
                </notebook>
                <xpath expr="//field[@name='invoice_user_id']" position="after">
                    <field name="sf_owner_id" readonly="1" widget="many2one_avatar_user"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
<odoo>
    <data>
        <!-- Inherit the sale.order form view -->
        <record id="view_order_form_inherit_salesforce" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.salesforce</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Add Salesforce button in header -->
                <xpath expr="//header" position="inside">
                    <button name="action_open_in_salesforce"
                            type="object"
                            string="Ver en Salesforce"
                            class="oe_highlight"
                            icon="fa-cloud"
                            invisible="not sf_id"
                            groups="salesforce_fields.group_salesforce_user"
                            help="Abrir registro en Salesforce"/>
                </xpath>
                <!-- Add a new page named 'Salesforce' -->
                <xpath expr="//notebook" position="inside">
                    <page  name="salesforce" string="Salesforce">
                        <!-- Add your custom fields here -->
                        <group>
                            <field name="sf_id" readonly="1"/>
                            <field name="sf_integration_status" readonly="1"/>
                            <field name="sf_integration_datetime" readonly="1"/>
                            <field name="sf_integration_error" readonly="1"/>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="sf_owner_id" widget="many2one_avatar_user"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
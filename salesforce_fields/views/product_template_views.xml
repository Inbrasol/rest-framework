<odoo>
    <record id="view_product_template_form_inherit_salesforce" model="ir.ui.view">
        <field name="name">product.template.form.inherit.salesforce</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="salesforce" string="Salesforce">
                    <group>
                        <group>
                            <field name="sf_id"/>
                            <field name="price_book_entry_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
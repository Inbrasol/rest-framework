<odoo>
    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='lead']" position="inside">
                <group>
                    <group string="Salesforce" name="Salesforce">
                        <field name="sf_id" readonly="1"/>
                        <field name="sf_integration_status" readonly="1"/>
                        <field name="sf_integration_datetime" readonly="1"/>
                        <field name="sf_integration_error" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="sf_owner_id" options="{'no_open': True}"/>
            </xpath>
        </field>
    </record>
    <record id="crm_lead_view_kanban_inherit" model="ir.ui.view">
        <field name="name">crm.lead.kanban</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <field name="sf_owner_id" 
                            widget="badge" options="{'class': 'oe_kanban_badge'}"/>
                        </div>
                    </t>
                </templates>
            </xpath>
        </field>
    </record>
</odoo>
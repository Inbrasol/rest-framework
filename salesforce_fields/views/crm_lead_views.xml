<odoo>
    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <!-- Add Salesforce button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_open_in_salesforce"
                        type="object"
                        string="Ver en Salesforce"
                        class="oe_highlight"
                        icon="fa-cloud"
                        invisible="not sf_id"
                        groups="salesforce_fields.group_salesforce_user"
                        help="Abrir registro en Salesforce"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="inside">
                <group>
                    <group string="Salesforce" name="Salesforce">
                        <field name="sf_id" readonly="1"/>
                        <field name="sf_integration_status" readonly="1"/>
                        <field name="sf_integration_datetime" readonly="1"/>
                        <field name="sf_integration_error" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="user_id" context="{'default_sales_team_id': team_id}"
                    widget="many2one_avatar_user" invisible="source_system != 'odoo'"/>
                <field name="sf_owner_id" readonly="1" widget="many2one_avatar_user"  invisible="source_system != 'salesforce'"/>
                <field name="source_system" readonly="1" placeholder="Source System" widget="badge"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_kanban_inherit" model="ir.ui.view">
        <field name="name">crm.lead.kanban</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_lead_kanban" />
        <field name="arch" type="xml">
            <!-- Ubicamos la sección a modificar -->
            <xpath expr="//div[@class='oe_kanban_bottom_right']/field[@name='user_id']" position="replace">
                <!-- 🔹 Aquí colocamos el nuevo contenido -->
                <field name="user_id"/>
                <field name="sf_owner_id"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="source_system"/>
            </xpath>
        </field>
    </record>
</odoo>